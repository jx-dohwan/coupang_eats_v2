# -------------------------------------------------------------------------
# Terraform — 올라가면 안 되는 것
# -------------------------------------------------------------------------

# 로컬 플러그인 / 모듈 캐시
**/.terraform/*

# 상태 파일 (시크릿·리소스 ID 포함)
*.tfstate
*.tfstate.*

# plan 산출물
*.tfplan
tfplan
tfplan-*

# 민감 변수
*.tfvars
*.tfvars.json
*.auto.tfvars
!*.tfvars.example

# 크래시 / override
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# OS
.DS_Store
