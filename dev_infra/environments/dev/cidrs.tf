# =============================================================================
# cidrs.tf  ← 서브넷 주소(CIDR)는 오직 이 파일에만 적는다
#
# IP 모양:  10.0.X.0/24
#           │  │ │
#           │  │ └─ 호스트 (서브넷 안 자리)
#           │  └─── 3번째 옥텟 X = 구역 번호 (우리가 티어를 구분하는 숫자)
#           └────── VPC 앞자리 (10.0)
#
# 구역 번호 X 약속 (하드코딩, 자동 계산 아님):
#   0, 1, 2     = 퍼블릭     (한 자리)
#  10, 11, 12   = 앱 프라이빗 (10번대)
#  20, 21, 22   = DB          (20번대)
#
# 이 값을 바꾸려면 이 파일만 고치면 된다.
# =============================================================================

locals {
  vpc_cidr = "10.0.0.0/16"

  # 키 a/b/c = 가용영역. 서브넷·라우팅 테이블도 같은 키를 쓴다.
  azs = {
    a = "ap-northeast-2a"
    b = "ap-northeast-2b"
    c = "ap-northeast-2c"
  }

  # 퍼블릭: 10.0.0 / 10.0.1 / 10.0.2
  public_subnet_cidrs = {
    a = "10.0.0.0/24" # X = 0
    b = "10.0.1.0/24" # X = 1
    c = "10.0.2.0/24" # X = 2
  }

  # 앱 프라이빗: 10.0.10 / 10.0.11 / 10.0.12
  private_app_subnet_cidrs = {
    a = "10.0.10.0/24" # X = 10
    b = "10.0.11.0/24" # X = 11
    c = "10.0.12.0/24" # X = 12
  }

  # DB: 10.0.20 / 10.0.21 / 10.0.22
  private_db_subnet_cidrs = {
    a = "10.0.20.0/24" # X = 20
    b = "10.0.21.0/24" # X = 21
    c = "10.0.22.0/24" # X = 22
  }
}
