# APP
NODE_ENV=local
PORT=3000
BASE_URL=http://localhost:3000
NAME=coupang-eats-backend

# DB (MySQL / Aurora 호환)
DB_HOST=localhost
DB_PORT=3306
DB_USER_NAME=root
DB_PASSWORD=password
DB_DATABASE=coupangeats

# Redis (로컬은 TLS 없음, ECS ElastiCache는 TLS)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRATION=900s
JWT_REFRESH_EXPIRATION=7d

# AWS
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET_NAME=coupang-eats-dev-storage
# ECS에서는 Terraform이 CloudFront URL을 주입. 로컬 CDN 없으면 비워 두면 S3 직접 URL fallback
AWS_CDN_URL=
AWS_SES_SENDER_EMAIL=your-verified@email.com
